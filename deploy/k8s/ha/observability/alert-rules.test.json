    {
      "name": "WtsAlertDeliveryFailed threshold recovery and namespace isolation",
      "interval": "5s",
      "input_series": [
        {
          "series": "prometheus_notifications_errors_total{namespace=\"a\",service=\"prometheus\"}",
          "values": "0x1 1x6 1x60"
        },
        {
          "series": "prometheus_notifications_errors_total{namespace=\"b\",service=\"prometheus\"}",
