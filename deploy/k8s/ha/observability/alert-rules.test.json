{
  "rule_files": [
    "prometheus-rules.yaml"
  ],
  "evaluation_interval": "5s",
  "tests": [
    {
      "name": "WtsHaSourceStale threshold recovery and namespace isolation",
      "interval": "5s",
      "input_series": [
        {
          "series": "wts_ha_source_age_seconds{namespace=\"a\",pod=\"gateway\"}",
          "values": "0 NaN NaN 0x2"
        },
        {
          "series": "wts_ha_source_age_seconds{namespace=\"b\",pod=\"gateway\"}",
          "values": "0x80"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "5s",
          "alertname": "WtsHaSourceStale",
          "exp_alerts": []
        },
        {
          "eval_time": "10s",
          "alertname": "WtsHaSourceStale",
          "exp_alerts": [
            {
              "exp_labels": {
                "namespace": "a",
                "pod": "gateway",
                "severity": "critical"
              },
              "exp_annotations": {
                "summary": "HA source 또는 broker 관측이 만료됐습니다.",
                "runbook_url": "https://github.com/yceffort/ws-trade-server/blob/main/docs/ha-runbook.md#alert-response",
                "dashboard_url": "http://localhost:3000/d/wts-overview?var-namespace=a&var-pod=All"
              }
            }
          ]
        },
        {
          "eval_time": "5m30s",
          "alertname": "WtsHaSourceStale",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "WtsLogsDropped threshold recovery and namespace isolation",
      "interval": "5s",
      "input_series": [
        {
          "series": "wts_logs_dropped_total{namespace=\"a\",pod=\"gateway\"}",
          "values": "0x1 1x2 1x60"
        },
        {
          "series": "wts_logs_dropped_total{namespace=\"b\",pod=\"gateway\"}",
          "values": "0x80"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "5s",
          "alertname": "WtsLogsDropped",
          "exp_alerts": []
        },
        {
          "eval_time": "20s",
          "alertname": "WtsLogsDropped",
          "exp_alerts": [
            {
              "exp_labels": {
                "namespace": "a",
                "pod": "gateway",
                "severity": "warning"
              },
              "exp_annotations": {
                "summary": "애플리케이션 로그 큐에서 로그를 폐기했습니다.",
                "runbook_url": "https://github.com/yceffort/ws-trade-server/blob/main/docs/ha-runbook.md#alert-response",
                "dashboard_url": "http://localhost:3000/d/wts-overview?var-namespace=a&var-pod=All"
              }
            }
          ]
        },
        {
          "eval_time": "5m30s",
          "alertname": "WtsLogsDropped",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "WtsLogsDropped counter reset is not an increase",
      "interval": "5s",
      "input_series": [
        {
          "series": "wts_logs_dropped_total{namespace=\"a\",pod=\"gateway\"}",
          "values": "100x4 0x70"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "1m",
          "alertname": "WtsLogsDropped",
          "exp_alerts": []
        }
      ]
    },
