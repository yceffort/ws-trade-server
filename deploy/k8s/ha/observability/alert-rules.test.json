      ]
    },
    {
      "name": "missing required fields despite successful scrape",
      "interval": "5s",
      "input_series": [
        {
          "series": "up{job=\"wts-ha\",namespace=\"a\",pod=\"gateway\"}",
          "values": "1x12"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "25s",
          "alertname": "WtsHaMetricsIncomplete",
          "exp_alerts": []
        },
        {
          "eval_time": "30s",
          "alertname": "WtsHaMetricsIncomplete",
          "exp_alerts": [
            {
              "exp_labels": {
                "namespace": "a",
                "pod": "gateway",
                "job": "wts-ha",
                "severity": "critical"
              },
              "exp_annotations": {
                "summary": "수집은 성공했지만 필수 HA 지표가 빠졌습니다.",
                "runbook_url": "https://github.com/yceffort/ws-trade-server/blob/main/docs/ha-runbook.md#alert-response",
                "dashboard_url": "http://localhost:3000/d/wts-overview?var-namespace=a&var-pod=All"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "collector endpoint disappearance and rediscovery",
      "interval": "5s",
      "input_series": [
        {
          "series": "up{job=\"wts-observability\",namespace=\"wts-observability\",service=\"alloy\"}",
          "values": "1 stale _x6 1x5"
        },
        {
          "series": "up{job=\"wts-observability\",namespace=\"wts-observability\",service=\"loki\"}",
          "values": "1x15"
        },
        {
          "series": "up{job=\"wts-observability\",namespace=\"wts-observability\",service=\"alertmanager\"}",
          "values": "1x15"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "30s",
          "alertname": "WtsObservabilityMissing",
          "exp_alerts": []
        },
        {
          "eval_time": "35s",
          "alertname": "WtsObservabilityMissing",
          "exp_alerts": [
            {
              "exp_labels": {
                "namespace": "wts-observability",
                "service": "alloy",
                "severity": "critical"
              },
              "exp_annotations": {
                "summary": "관측 구성 요소 수집 실패 또는 endpoint 소실입니다.",
                "runbook_url": "https://github.com/yceffort/ws-trade-server/blob/main/docs/ha-runbook.md#alert-response",
                "dashboard_url": "http://localhost:3000/d/wts-overview?var-namespace=wts-observability&var-pod=All"
              }
            }
          ]
        },
        {
          "eval_time": "40s",
          "alertname": "WtsObservabilityMissing",
          "exp_alerts": []
        }
      ]
    }
